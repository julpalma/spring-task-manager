      "name": "Get Tasks by Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"All tasks have status PENDING\", function () {",
              "    var tasks = pm.response.json();",
              "    tasks.forEach(task => {",
              "        pm.expect(task.status).to.eql(\"PENDING\");",
              "    });",
              "});",
              ""
